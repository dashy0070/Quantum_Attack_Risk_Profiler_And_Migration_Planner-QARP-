# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Temporary and Lock files
~$*
*.tmp
*.temp
~WRL*

# Non-essential / Scratch Folders
backup/
templates/
Proposal/

# Documents & Presentations
*.docx
*.doc
*.pptx
*.ppt
*.pdf
*.txt
!requirements.txt

# Root-level Excel and duplicate files (Excel allowed only under reports/)
*.xlsx
*.xls
*.csv.xlsx
!reports/*.xlsx

# Image Files
*.png
*.svg
*.jpg
*.jpeg
*.gif

# OS specific
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
